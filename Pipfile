[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[scripts]
build = "sam build"
deploy = "sam deploy"
test = "pytest --cov --cov-branch --cov-report=term-missing tests/unit/"
test-report = "pytest --cov --cov-branch --cov-report=term-missing --cov-report=xml tests/unit/"
test-integration = "pytest --cov --cov-branch --cov-report=term-missing"
convert-docs = "sphinx-apidoc -f -o docs-src/ src/"
build-docs = "sphinx-build -b html docs-src/ docs/"

[packages]
# dev-packagesのaws-sam-cliで利用するboto3とのバージョン差異を無くすため、
# packagesとdev-packagesのboto3は同じバージョンにすることが望ましい
boto3 = "==1.43.108"

[dev-packages]
boto3 = "==1.43.108"
pyyaml = ">=6.0.3"
pytest = ">=9.0"
pytest-mock = ">=3.14"
requests = "~=2.33.0"
pytest-cov = "~=4.0.0"
moto = "~=5.1.0"
sphinx = "*"
sphinx-rtd-theme = "*"
pyopenssl = "~=26.0.0"
aws-sam-cli = "==1.172.1"

[requires]
python_version = "3.14"
